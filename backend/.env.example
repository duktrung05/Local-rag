# ============================================
# RAG Chatbot - Cấu hình
# ============================================

# ── LLM Provider ────────────────────────────
# "groq"   → KHUYẾN NGHỊ cho VN (miễn phí, cực nhanh, không bị 429)
# "gemini" → Hay bị 429 ở Việt Nam
# "claude" → Trả phí, chất lượng rất cao
# "ollama" → Hoàn toàn offline
LLM_PROVIDER=groq

# ── Groq (KHUYẾN NGHỊ - miễn phí, hoạt động tốt ở VN) ──────────
# Lấy key miễn phí tại: https://console.groq.com
# Đăng ký → API Keys → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# Các model Groq:
#   llama-3.3-70b-versatile  → KHUYẾN NGHỊ: mạnh nhất, tiếng Việt tốt
#   llama-3.1-8b-instant     → siêu nhanh, nhẹ
#   mixtral-8x7b-32768       → context dài 32k tokens
#   gemma2-9b-it             → Google Gemma 2
GROQ_MODEL=llama-3.3-70b-versatile

# ── Gemini (alternative - hay bị lỗi 429 ở VN) ──────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── Anthropic Claude (trả phí) ───────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-opus-4-5

# ── Ollama (offline) ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embedding ────────────────────────────────────────────────────
# "local" → SentenceTransformers (offline, ~400MB, đủ tốt)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── Vector Database ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=documents

# ── SQLite ───────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/chat_history.db

# ── Chunking ─────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ────────────────────────────────────────────────────
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3

# ── Generation ───────────────────────────────────────────────────
MAX_TOKENS=2048
TEMPERATURE=0.7

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
